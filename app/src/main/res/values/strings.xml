    <!-- Permission catalogue (PermissionsController) -->
    <string name="perm_bluetooth">Bluetooth</string>
    <string name="perm_bluetooth_desc">Connect to your vehicle via BLE 5.0</string>
    <string name="perm_bluetooth_why">Required to exchange data between your vehicle\'s instrument cluster and this app, so directions can appear on the cluster.</string>
    <string name="perm_location">Location</string>
    <string name="perm_location_desc">Required for turn-by-turn navigation</string>
    <string name="perm_location_why">Required for real-time turn-by-turn navigation on the cluster. Android also blocks Bluetooth scanning entirely without it, so your scooter cannot be found until this is on.</string>
    <string name="perm_notifications">Notifications</string>
    <string name="perm_notifications_desc">Ride alerts and service reminders</string>
    <string name="perm_notifications_why">Lets RideConnectX show the connection notice while it is linked to your vehicle, plus service reminders and ride summaries.</string>
    <string name="perm_signal">Phone status</string>
    <string name="perm_signal_desc">Show your signal strength on the vehicle cluster</string>
    <string name="perm_signal_why">Required to read your signal strength so it can be drawn on the cluster next to the Bluetooth glyph, the same as the official app. Refused, the cluster simply shows no bars.</string>

    <string name="perm_contacts">Contacts</string>
    <string name="perm_contacts_desc">Pick emergency contacts, and show caller names on the cluster</string>
    <string name="perm_contacts_why">Lets you choose an emergency contact from your phone, and lets the cluster show a caller\'s name instead of a bare number. Contacts are read on this phone and never leave it.</string>
    <string name="perm_photos">Photos and media</string>
    <string name="perm_photos_desc">Set your profile picture</string>
    <string name="perm_photos_why">Lets you set your rider profile picture. On Android 14 and later you can allow only selected photos rather than your whole gallery — the app works either way.</string>

